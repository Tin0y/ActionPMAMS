# PostgreSQL Database Configuration (Required)
PGHOST=localhost
PGPORT=5432
PGDATABASE=APMaMS
PGUSER=postgres
PGPASSWORD="<YOUR_SECURE_POSTGRES_PASSWORD>"
PGSCHEMA=apmams
PSQL_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\psql.exe"

# Production Environment & Security Hardening
NODE_ENV=development
PORT=3000

# Allowed CORS & CSRF Origins (comma-separated for multiple origins)
# Example: "http://localhost:3000,http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Session Security Configuration
# SESSION_IDLE_TIMEOUT_SECONDS: Inactivity idle timeout in seconds (default: 3600 = 1 hour)
SESSION_IDLE_TIMEOUT_SECONDS=3600

# CSRF Secret Salt for Double-Submit & Token Verification
CSRF_SECRET="<CHANGE_TO_RANDOM_LONG_SECRET_IN_PRODUCTION>"

# Optional External Integrations
# GEMINI_API_KEY="<YOUR_GEMINI_API_KEY>"
# APP_URL="http://localhost:3000"

# ==============================================================================
# Automated Email Notifications (Gmail SMTP / Institutional Relay)
# ==============================================================================
# To deliver automated emails directly to recipient @msunaawan.edu.ph / Gmail inboxes
# on activity submission, endorsement, and approval, configure ONE of the options below:
#
# Option A: Gmail / Google Workspace (Requires 16-character Google App Password)
# 1. Enable 2-Step Verification on sender Google account (e.g. hazelanne.mapula@msunaawan.edu.ph or system account)
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Paste the credentials below:
# GMAIL_USER="hazelanne.mapula@msunaawan.edu.ph"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
#
# Option B: Generic Institutional SMTP Relay (e.g. MSUN server, Brevo, SendGrid)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your-email@msunaawan.edu.ph"
# SMTP_PASS="your-smtp-password-or-app-password"
# SMTP_FROM="no-reply-actionplan@msunaawan.edu.ph"
